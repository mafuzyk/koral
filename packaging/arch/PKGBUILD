# Maintainer: mafuzyk <https://github.com/mafuzyk/koral>
pkgname=koral
pkgver=1.2.1
pkgrel=1
pkgdesc='A GPU-accelerated Rust terminal emulator with Wayland, X11, and native sharky shell support'
arch=('x86_64')
url='https://github.com/mafuzyk/koral'
license=('GPL-3.0-only')
depends=(
  'fontconfig'
  'libglvnd'
  'libx11'
  'libxcursor'
  'libxi'
  'libxkbcommon'
  'libxrandr'
  'ncurses'
  'vulkan-icd-loader'
  'wayland'
)
makedepends=('cargo')
optdepends=(
  'libnotify: desktop notification integration'
  'xdg-utils: opening links via xdg-open'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 target/release/koral "${pkgdir}/usr/bin/koral"
  install -Dm644 assets/koral.desktop "${pkgdir}/usr/share/applications/koral.desktop"
  install -Dm644 assets/koral.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/koral.svg"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -dm755 "${pkgdir}/usr/share/terminfo"
  tic -x -o "${pkgdir}/usr/share/terminfo" assets/xterm-koral.terminfo
}
